# Reproducible installs and ESM-friendly defaults.
save-exact=true
engine-strict=true

# Supply-chain hardening.
# No lifecycle scripts from any dependency (this also skips OUR OWN prepack/
# prepare hooks, so CI and release tooling must run builds explicitly).
ignore-scripts=true
# Cooldown: refuse package versions published less than 14 days ago (npm >= 11.10).
min-release-age=14
