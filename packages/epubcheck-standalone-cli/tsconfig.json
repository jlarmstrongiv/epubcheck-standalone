{
  // Extends the monorepo base (strict, NodeNext ESM); only the CLI-specific
  // rootDir/outDir/types differ from the shared settings.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "WebWorker", "esnext.disposable"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
