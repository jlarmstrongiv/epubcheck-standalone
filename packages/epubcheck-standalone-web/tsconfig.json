{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["astro/client"],
    "customConditions": ["source"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
